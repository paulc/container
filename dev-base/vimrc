set     ai
set     tabstop=4
set     shiftwidth=4
set     expandtab
set     smarttab
set     winminheight=0

let s:backupdir = expand('~/.vim_backup')
if !isdirectory(s:backupdir)
    call mkdir(s:backupdir, 'p', 0700)
endif

let s:directory = expand('~/.vim_backup/swap')
if !isdirectory(s:directory)
    call mkdir(s:directory, 'p', 0700)
endif

set     backup
set     backupdir=~/.vim_backup//
set     directory=~/.vim_backup/swap//

