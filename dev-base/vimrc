" Yank text from ALEHover popup
function! YankPopupText() abort
    if !has('popupwin')
        echohl ErrorMsg | echo 'This Vim lacks +popupwin' | echohl NONE
        return
    endif

    let l:ids = popup_list()
    if empty(l:ids)
        echohl WarningMsg | echo 'No popup open' | echohl NONE
        return
    endif

    let l:buf = winbufnr(l:ids[0])
    if l:buf == -1
        echohl WarningMsg | echo 'Popup has no buffer' | echohl NONE
        return
    endif

    let l:lines = getbufline(l:buf, 1, '$')
    let @* = join(l:lines, "\n")
    echo printf('Yanked %d line%s to *', len(l:lines), len(l:lines) == 1 ? '' : 's')
endfunction

nnoremap <silent> <leader>yp :call YankPopupText()<CR>

if has("autocmd")
    augroup text
        au!
        autocmd BufRead,BufNewFile *.txt setlocal tw=78
        autocmd BufRead,BufNewFile *.sh setlocal showbreak=
    augroup END
    augroup rust
        au!
        autocmd FileType rust let @p = 'oprintln!("{:?}",);hi'
        autocmd FileType rust let @l = 'olog::info!("");hhi'
        autocmd FileType rust let @d = 'odefmt::info!("");hhi'
        autocmd FileType rust let g:rustfmt_autosave = 1
    augroup END
    augroup deno
        au!
        autocmd FileType javascript,javascriptreact,typescript,typescriptreact setlocal tabstop=2
        autocmd FileType javascript,javascriptreact,typescript,typescriptreact setlocal shiftwidth=2
    augroup END
    augroup go
        au!
        autocmd FileType go setlocal autowrite
        autocmd FileType go let g:go_fmt_command = "goimports"
    augroup END
    augroup make
        au!
        autocmd FileType make setlocal noexpandtab
    augroup END
    augroup cprog
        au!
        autocmd FileType c,cpp  setlocal formatoptions=croql cindent comments=sr:/*,mb:*,el:*/,://
    augroup END
    augroup html
        au!
        autocmd FileType html setlocal tabstop=2
        autocmd FileType html setlocal shiftwidth=2
    augroup END
    augroup autoquickfix
        autocmd!
        autocmd QuickFixCmdPost [^l]* cwindow
        autocmd QuickFixCmdPost    l* lwindow
    augroup END
endif

